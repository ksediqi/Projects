            </li>
        </ul>
    </nav>
    <div class="user-menu">
        <!-- This is your existing login button -->


        <!-- Dropdown menu -->
        <div class="user-menu-dropdown hidden" id="userMenuDropdown">
            <button class="dropdown-item" type="button" id="profileBtn">
                Profile
            </button>
            <button class="dropdown-item" type="button" id="settingsBtn">
                Settings
            </button>
            <hr class="dropdown-divider"/>
            <button class="dropdown-item dropdown-logout" type="button" id="logoutBtn">
                Log out
            </button>
        </div>
    </div>
    <div popover="auto" id="mypopover" class="faq-popover" aria-labelledby="faq-title">
        <div class="faq-header">
            <h4 id="faq-title">Frequently Asked Questions</h4>
            <button class="faq-close" popovertarget="mypopover" popovertargetaction="hide" aria-label="Close FAQ">
                X
            </button>
        </div>
        <div class="faq-body">
            <details class="faq-item">
                <summary>What is this site about?</summary>
                <div class="faq-answer">
                    MovieTheater lets you browse, search, and manage movies and TV shows in a simple, clean
                    dashboard.
                </div>
            </details>
            <details class="faq-item">
                <summary>How do I create an account?</summary>
                <div class="faq-answer">
                    Click "Sign up" or "Login" and follow the steps. You'll be ready to build your watchlist in
                    under a
                    minute.
                </div>
            </details>
            <details class="faq-item">
                <summary class="faq-summar">Can I switch between dark and light mode?</summary>
                <div class="faq-answer">
                    Yes. Use the theme toggle in the main header (when enabled). Your choice is saved for your next
                    visit.
                </div>
            </details>
            <details class="faq-item">
                <summary>Who do I contact for support?</summary>
                <div class="faq-answer">
                    Email support@example.com or use the in-app chat. We usually respond within one business day.
                </div>
            </details>
            <!--Report bugs or any-->
            <details class="faq-item">
                <summary>Report</summary>
                <div class="faq-answer">
                    Please report any bugs or any issues
                </div>
                <div id="toast" class="toast">
                    <span style="font-weight:500; color:var(--color-text);">Submitted:</span>
                    <pre id="toast-body"></pre>
                </div>

                <div class="report-card">
                    <div class="card-header">
                        <p class="card-title">Bug Report</p>
                        <p class="card-desc">Help us improve by reporting bugs you encounter.</p>
                    </div>
                    <div class="card-body">
                        <div class="field">
                            <label for="bug-title">Bug title</label>
                            <input type="text" id="bug-title" placeholder="Login button not working on mobile"
                                   autocomplete="off"/>
                            <span class="field-error" id="err-title"></span>
                        </div>
                        <div class="field">
                            <label for="bug-desc">Description</label>
                            <div class="input-group">
                        <textarea id="bug-desc" rows="6"
                                  placeholder="I'm having an issue with the login button on mobile."></textarea>
                                <span class="char-count" id="char-count">0/100</span>
                            </div>
                            <span class="field-desc">Include steps to reproduce, expected behavior, and what actually happened.</span>
                            <span class="field-error" id="err-desc"></span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="button" class="btn-primary" id="btn-reset">Reset</button>
                        <button type="button" class="btn" id="btn-submit">Submit</button>
                    </div>
                </div>
            </details>
        </div>


        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </div>
    <!-- implement this to the Frequently questions -->
    <!-- https://www.youtube.com/shorts/9mUhkhs_os8 -->

</header>

