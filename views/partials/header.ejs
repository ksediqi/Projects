<script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqPopover = document.getElementById('mypopover');
        const faqAccordionItems = document.querySelectorAll('.faq-item');

        if (!faqPopover) return; // Exit if the popover doesn't exist on this page

        // --- Problem 1 & 2: Reset accordion when popover closes ---
        // The browser fires a "toggle" event on the popover element itself.
        faqPopover.addEventListener('toggle', function (event) {
            // The event.newState will be "closed" when the popover is hidden.
            if (event.newState === 'closed') {

                // Loop through all <details> elements and remove the 'open' attribute.
                faqAccordionItems.forEach(item => {
                    item.removeAttribute('open');


                });

            }
        });

        // --- Problem 3: Make the accordion exclusive (only one open at a time) ---
        faqAccordionItems.forEach(itemToOpen => {
            // Listen for the 'toggle' event on each <details> element.
            itemToOpen.addEventListener('toggle', () => {
                // If the item we just interacted with is now open...
                if (itemToOpen.open) {

                    // ...then loop through all the other items...
                    faqAccordionItems.forEach(itemToClose => {
                        // ...and if it's not the one we just opened, close it.
                        if (itemToClose !== itemToOpen) {

                            itemToClose.removeAttribute('open');

                        }

                    });

                }
            });
        });

    });


    /* ── Hamburger menu ── */
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');

    hamburger?.addEventListener('click', () => {
        const expanded = hamburger.getAttribute('aria-expanded') === 'true';
        hamburger.setAttribute('aria-expanded', String(!expanded));
        navLinks.classList.toggle('active');
    });


    // Bug-report card lives inside the FAQ popover (#mypopover), which is
    // only rendered when the main site header is shown (see hideMainNav in
    // partials/header.ejs). Guard the whole block so pages that hide it
    // (e.g., the library page, which has its own nav) don't crash here.
    const titleInput = document.getElementById('bug-title');
    const descInput = document.getElementById('bug-desc');

    if (titleInput && descInput) {
        const charCount = document.getElementById('char-count');
        const errTitle = document.getElementById('err-title');
        const errDesc = document.getElementById('err-desc');
        const toast = document.getElementById('toast');
        const toastBody = document.getElementById('toast-body');
        const reportCard = document.querySelector('.report-card');

        descInput.addEventListener('input', () => {
            charCount.textContent = descInput.value.length + '/100';
        });

        const validateTitle = (val) => {
            if (val.length < 5) return 'Bug title must be at least 5 characters.';
            if (val.length > 32) return 'Bug title must be at most 32 characters.';
            return '';
        };

        const validateDesc = (val) => {
            if (val.length < 20) return 'Description must be at least 20 characters.';
            if (val.length > 100) return 'Description must be at most 100 characters.';
            return '';
        };

        const showError = (input, errEl, msg) => {
            if (msg) {
                input.classList.add('invalid');
                errEl.textContent = msg;
                errEl.classList.add('visible');
            } else {
                input.classList.remove('invalid');
                errEl.textContent = '';
                errEl.classList.remove('visible');
            }
        };

        const resetForm = () => {
            titleInput.value = '';
            descInput.value = '';
            charCount.textContent = '0/100';
            showError(titleInput, errTitle, '');
            showError(descInput, errDesc, '');
            toast.classList.remove('show');
        };

        titleInput.addEventListener('blur', () => showError(titleInput, errTitle, validateTitle(titleInput.value)));
        descInput.addEventListener('blur', () => showError(descInput, errDesc, validateDesc(descInput.value)));

        document.getElementById('btn-submit')?.addEventListener('click', () => {
            const te = validateTitle(titleInput.value);
            const de = validateDesc(descInput.value);
            showError(titleInput, errTitle, te);
            showError(descInput, errDesc, de);
            if (te || de) return;

            const data = {title: titleInput.value, description: descInput.value};
            toastBody.textContent = JSON.stringify(data, null, 2);
            toast.classList.add('show');
            reportCard.classList.add('hidden');
            setTimeout(() => {
                toast.classList.remove('show');
                reportCard.classList.remove('hidden');
                // Calling reset form function here
                resetForm();
            }, 5000);

        });

        document.getElementById('btn-reset')?.addEventListener('click', () => {
            resetForm();
        });
    }


</script>