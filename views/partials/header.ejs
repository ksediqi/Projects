            <span></span><span></span><span></span>
        </button>

        <!-- Logo lives directly in nav, not inside the ul -->
        <a href="/" class="main-nav-logo">
            <span class="logo-bracket">{</span> dev.portfolio <span class="logo-bracket">}</span>
        </a>

        <!-- Only action buttons remain in the ul -->
        <ul id="navLinks" class="main-nav-link">
            <li>
                <button class=" btn-login user-menu-toggle" id="userMenuToggle">
                    <span>Login</span>


                </button>

            </li>
            <li>
                <button>
                    <span>Free</span>
                </button>

            </li>
            <li>
                <button type="button" class="btn createAccountBtn " popovertarget="signUpPopover">
                    <span>Create Account</span>
                </button>

            </li>
            <li>
                <button>
                    <span>Price</span>
                </button>
            </li>

            <li>
                <button id="theme-toggle" class="main-btn   theme-toggle"
                        title="Toggle Dark Mode" aria-label="Toggle Dark Mode">
                    <i class="fas fa-adjust"></i>
                </button>
            </li>
            <li>
                <button class="main-btn btn-help " popovertarget="mypopover"
