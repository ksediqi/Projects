<!-- ── Libraex library-card login / signup modal ─────────────────
     Popover-based (native Popover API, same mechanism as the
     site-wide loginPopover) so it gets free light-dismiss +
     top-layer stacking. Styled by /css/lib-login.css and driven by
     /js/lib-login.js. -->
<div id="libLoginModal" popover="auto" class="lib-auth-modal" aria-labelledby="libAuthTitle">
    <div class="page">

        <!-- Left: brand / atmosphere panel -->
        <div class="panel-left">
            <div class="panel-left-logo">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Z"
                          stroke="var(--clr-accent)" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M4 19a2.5 2.5 0 0 1 2.5-2.5H20" stroke="var(--clr-accent)" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div class="logo-name">Libraex<span>Library Card</span></div>
            </div>

            <div class="panel-left-copy">
                <blockquote>A room without books is like a body without a soul.</blockquote>
                <cite>— Marcus Tullius Cicero</cite>
            </div>

            <p class="panel-left-footer">
                Your library card unlocks reading and syncs your plan across every device.<br/>
                <a href="#pricing"
                   onclick="smoothScroll(event,'pricing'); document.getElementById('libLoginModal').hidePopover();">
                    See membership plans →
                </a>
            </p>
        </div>

        <!-- Right: forms -->
        <div class="panel-right">
            <div class="form-card">
                <button type="button" class="modal-close" id="libAuthClose" popovertarget="libLoginModal"
                        popovertargetaction="hide" aria-label="Close">&times;
                </button>

                <div id="js-alert" class="alert" role="alert" aria-live="assertive"></div>

                <!-- ── Sign in ─────────────────────────────────────── -->
                <div id="libLoginView">
                    <div class="form-header">
                        <h1 id="libAuthTitle">Welcome back, reader.</h1>
                        <p>Sign in with your library card to read and manage your subscription.</p>
                    </div>

                    <form id="js-login-form" novalidate>
                        <div class="field-group">
                            <label for="username">Library card # or email</label>
                            <div class="input-wrap">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M4 6h16v12H4z" stroke-width="1.6" stroke-linejoin="round"/>
                                    <path d="m4 7 8 6 8-6" stroke-width="1.6" stroke-linejoin="round"/>
                                </svg>
                                <input type="text" id="username" placeholder="you@example.com"
                                       autocomplete="username" required/>
                            </div>
                            <span class="field-error" id="username-error">Please enter your library card number or email.</span>
                        </div>

                        <div class="field-group">
                            <label for="password">Password</label>
                            <div class="input-wrap">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="10" rx="2" stroke-width="1.6"/>
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-width="1.6"/>
                                </svg>
                                <input type="password" id="password" placeholder="••••••••"
                                       autocomplete="current-password" required/>
                                <button type="button" class="btn-toggle-pw" id="js-toggle-pw"
                                        aria-label="Show password">
                                    <svg id="icon-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z"
                                              stroke-width="1.6"/>
                                        <circle cx="12" cy="12" r="3" stroke-width="1.6"/>
                                    </svg>
                                    <svg id="icon-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                                         style="display:none">
                                        <path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.24 4.24M9.9 5.1A10.9 10.9 0 0 1 12 5c7 0 10.5 7 10.5 7a13.3 13.3 0 0 1-3.15 4.05M6.3 6.3C3.75 8 1.5 12 1.5 12a13.4 13.4 0 0 0 4.9 5.4"
                                              stroke-width="1.6" stroke-linecap="round"/>
                                    </svg>
                                </button>
                            </div>
                            <span class="field-error" id="password-error">Please enter your password.</span>
                        </div>

                        <div class="form-extras">
                            <label class="checkbox-label">
                                <input type="checkbox" id="remember"/> Remember me
                            </label>
                            <a href="#" class="link-forgot" id="js-forgot-link">Forgot password?</a>
                        </div>

                        <button class="btn-primary" type="submit" id="js-submit-btn">
                            <span id="btn-label">Sign In</span>
                            <span class="spinner" id="js-spinner"></span>
                        </button>
                    </form>

                    <div class="divider"><span></span></div>

                    <p class="form-footer">
                        New to Libraex?
                        <button type="button" class="link-forgot as-link" id="js-open-signup">Create an account</button>
                    </p>
                </div>

                <!-- ── Sign up ─────────────────────────────────────── -->
                <div id="libSignupView" class="hidden">
                    <div class="form-header">
                        <h1>Get your library card.</h1>
                        <p>Create a free account — upgrade to Pro any time.</p>
                    </div>

                    <form id="js-signup-form" novalidate>
                        <div class="field-group">
                            <label for="signupName">Full name</label>
                            <div class="input-wrap">
                                <input type="text" id="signupName" placeholder="Jane Doe" autocomplete="name" required/>
                            </div>
                            <span class="field-error" id="signupName-error">Please enter your name.</span>
                        </div>

                        <div class="field-group">
                            <label for="signupEmail">Email</label>
                            <div class="input-wrap">
                                <input type="email" id="signupEmail" placeholder="you@example.com" autocomplete="email"
                                       required/>
                            </div>
                            <span class="field-error" id="signupEmail-error">Please enter a valid email.</span>
                        </div>

                        <div class="field-group">
                            <label for="signupUsername">Username</label>
                            <div class="input-wrap">
                                <input type="text" id="signupUsername" placeholder="jane_doe" autocomplete="username"
                                       required/>
                            </div>
                            <span class="field-error" id="signupUsername-error">Please choose a username.</span>
                        </div>

                        <div class="field-group">
                            <label for="signupPassword">Password</label>
                            <div class="input-wrap">
                                <input type="password" id="signupPassword" placeholder="8+ characters"
                                       autocomplete="new-password" required/>
                            </div>
                            <span class="field-error"
                                  id="signupPassword-error">Password must be at least 8 characters.</span>
                        </div>

                        <div class="field-group">
                            <label for="signupConfirmPassword">Confirm password</label>
                            <div class="input-wrap">
                                <input type="password" id="signupConfirmPassword" placeholder="Confirm password"
                                       autocomplete="new-password" required/>
                            </div>
                            <span class="field-error" id="signupConfirmPassword-error">Passwords don't match.</span>
                        </div>

                        <button class="btn-primary" type="submit" id="js-signup-submit-btn">
                            <span id="signup-btn-label">Create Account</span>
                            <span class="spinner" id="js-signup-spinner"></span>
                        </button>
                    </form>

                    <div class="divider"><span></span></div>

                    <p class="form-footer">
                        Already a member?
                        <button type="button" class="link-forgot as-link" id="js-open-login">Sign in</button>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Lightweight toast for confirmations (subscribe, sign-out, etc.) -->
<div id="libToast" class="lib-toast" role="status" aria-live="polite"></div>
