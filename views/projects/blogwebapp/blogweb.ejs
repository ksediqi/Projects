<%- include("../../partials/header.ejs") %>
<%- include("../../partials/head.ejs") %>


<div class="container-blog">
  <h1>Blog Web App</h1>
  <form action="/projects/blogwebapp/add" method="POST" class="post-form">
    <input type="text" name="title" placeholder="Title" required>
    <textarea name="content" placeholder="Content" rows="3" required></textarea>
    <button type="submit">Add Post</button>
  </form>
    <h1>Hello blog</h1>
  <div class="posts">
    <% if (posts.length === 0) { %>
      <p>No posts yet. Add your first one!</p>
    <% } %>
    <% posts.forEach(post => { %>
      <div class="post">
        <h2><%= post.title %></h2>
        <p><%= post.content %></p>
        <div class="actions">
          <a href="/projects/blogwebapp/edit/<%= post.id %>">Edit</a>
          <form action="/projects/blogwebapp/delete/<%= post.id %>" method="POST" style="display:inline;">
            <button type="submit" onclick="return confirm('Delete this post?')">Delete</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<%- include("../../partials/footer.ejs") %>