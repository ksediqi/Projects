                    </div>
                </div>

            </aside>

            <!-- FORM -->
            <div class="form-card">
                <div class="form-card-header">
                    <div class="form-card-icon">
                        <svg fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true" focusable="false">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="form-card-title">Send a message</div>
                        <div class="form-card-sub">I'll get back to you within 24 hours.</div>
                    </div>
                </div>

                <form class="contact-form" id="contactForm" novalidate>

                    <!-- Name + Email share a row on wider screens -->
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Name <span>*</span></label>
                            <input type="text" id="name" name="name" class="form-control" placeholder="John Doe"
                                   required/>
                        </div>
                        <div class="form-group">
                            <label for="email">Email <span>*</span></label>
                            <input type="email" id="email" name="email" class="form-control"
                                   placeholder="john@example.com" required/>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Subject <span>*</span></label>
                        <input type="text" id="subject" name="subject" class="form-control"
                               placeholder="Project enquiry, collaboration…" required/>
                    </div>

                    <div class="form-group">
                        <label for="message">Message <span>*</span></label>
                        <textarea id="message" name="message" class="form-control" rows="5"
                                  placeholder="Tell me about your project or just say hello…" required></textarea>
                    </div>

                    <div class="form-footer">
            <span class="form-note">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
              </svg>
              Your info stays private.
            </span>
                        <button type="submit" class="submit-btn btn-interface">
                            Send Message

                        </button>
                    </div>

                    <div class="success-toast" id="successToast" role="status" aria-live="polite">
                        <svg fill="none" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"
                             focusable="false">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Message sent! I'll be in touch soon.
                    </div>
                </form>
            </div><!-- /.form-card -->

        </div><!-- /.contact-layout -->
    </div><!-- /.container -->
</section>

<!-- Back to Top Floating Button -->
<button id="back-to-top" aria-label="Back to top">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 15l-6-6-6 6"/>
    </svg>
</button>

<!-- Project Detail Modal -->
<div class="project-modal-overlay" id="project-detail-modal" aria-hidden="true" role="dialog">
    <div class="project-modal-card">
        <button class="modal-close-btn" id="project-modal-close" aria-label="Close project modal">&times;</button>
        <div class="modal-body" id="project-modal-body">
            <h3 id="modal-title" style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #ffffff;">Project Title</h3>
            <p id="modal-desc" style="color: #94a3b8; margin-bottom: 1.5rem; line-height: 1.6;">Project detailed
                overview...</p>
            <div id="modal-tags" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;"></div>
            <div style="display: flex; gap: 1rem;">
                <a href="/projects/library" id="modal-live-link" target="_blank" class="btn-project-action btn-demo">Explore
                    Project ↗</a>
                <a href="https://github.com/ksediqi/PracticeProjects" target="_blank"
                   class="btn-project-action btn-details">GitHub Code ⚡</a>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Toast Notification -->
<div class="toast-notification" id="toast-notification" role="status" aria-live="polite">
    <span id="toast-message">Notification message</span>
</div>


