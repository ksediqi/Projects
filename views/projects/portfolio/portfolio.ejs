                            </svg>
                        </div>
                        <div class="detail-text">
                            <span class="detail-label">Location</span>
                            <span class="contact-value">Fremont, California</span>
                        </div>
                    </div>
                </div>

                <div class="social-card">
                    <div class="social-label">Find me online</div>
                    <div class="social-row">
                        <a href="#" class="social-btn" aria-label="GitHub">
                            <svg viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true" focusable="false">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/>
                            </svg>
                        </a>
                        <a href="#" class="social-btn" aria-label="LinkedIn">
                            <svg viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true" focusable="false">
