        <mxCell id="kwfWTUhXdJAbSmp7yqyK-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="Sequence Diagram&#xa;&#xa;Imagine someone searches for &quot;Batman.&quot;" vertex="1">
