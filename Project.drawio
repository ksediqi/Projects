        <mxCell id="kwfWTUhXdJAbSmp7yqyK-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="User&#xa;&#xa; |&#xa;&#xa; | Search Batman&#xa;&#xa; |&#xa;&#xa;React&#xa;&#xa; |&#xa;&#xa; | fetchMovies()&#xa;&#xa; |&#xa;&#xa;API Service&#xa;&#xa; |&#xa;&#xa; | GET /search/movie&#xa;&#xa; |&#xa;&#xa;TMDB&#xa;&#xa; |&#xa;&#xa; | JSON&#xa;&#xa; |&#xa;&#xa;API Service&#xa;&#xa; |&#xa;&#xa;React&#xa;&#xa; |&#xa;&#xa;Render Movie Cards" vertex="1">
