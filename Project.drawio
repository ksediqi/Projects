        </mxCell>
        <mxCell id="MI_eVZwsKVtq64ymUofx-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="User&#xa;&#xa;↓&#xa;&#xa;Clicks Search&#xa;&#xa;↓&#xa;&#xa;React Component&#xa;&#xa;↓&#xa;&#xa;Movie Service&#xa;&#xa;↓&#xa;&#xa;TMDB API&#xa;&#xa;↓&#xa;&#xa;JSON Response&#xa;&#xa;↓&#xa;&#xa;Update State&#xa;&#xa;↓&#xa;&#xa;Movie Cards Render" vertex="1">
          <mxGeometry height="440" width="130" x="340" y="120" as="geometry" />
        </mxCell>
        <mxCell id="MI_eVZwsKVtq64ymUofx-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="Every API request should have a flow like this." vertex="1">
          <mxGeometry height="40" width="280" x="270" y="580" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
